# Database (e.g. free PostgreSQL with pgvector from https://neon.tech or https://supabase.com)
DATABASE_URL=postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require

# Application Settings
PROJECT_NAME=DocuStream
PROJECT_VERSION=1.0.0
SECRET_KEY=super-secret-docustream-jwt-key-change-in-production-abcdef123456

# Google Gemini API (100% FREE at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key_here

# Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
