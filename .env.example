# Database
DATABASE_URL=postgresql://docustream_user:secretpassword@localhost:5432/docustream

# Application
PROJECT_NAME=DocuStream
PROJECT_VERSION=1.0.0
SECRET_KEY=super-secret-docustream-jwt-key-change-in-production-abcdef123456

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (REQUIRED - get your key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
